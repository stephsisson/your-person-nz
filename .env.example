# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables for
# production. Nothing here is required for the site to build and run —
# missing values simply disable that integration (enquiries log to the
# console instead of Airtable/email, and analytics scripts don't load).

# --- Enquiry form: Airtable ---
# Create a free Airtable base with a table (default name "Enquiries") with
# columns matching lib/submitEnquiry.ts, then get an API key from
# https://airtable.com/create/tokens (needs data.records:write scope on the base).
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Enquiries

# --- Enquiry form: email notification via Resend ---
# https://resend.com — free tier is plenty for pilot volume.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Your Person NZ <notifications@yourperson.nz>"
NOTIFY_EMAIL=hello@yourperson.nz

# --- Analytics: Plausible ---
# https://plausible.io — set this to the domain you register in Plausible
# (usually just yourperson.nz). Leave blank to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourperson.nz
